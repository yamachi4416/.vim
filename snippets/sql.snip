snippet print
options word
  DBMS_OUTPUT.PUT_LINE(${0});

snippet begin
    BEGIN
      ${0:TARGET}
    END;
    /

snippet declare
  DECLARE
    ${1}
  BEGIN
    ${0:TARGET}
  END;
  /

snippet if
  IF ${1} THEN
    ${0:TARGET}
  END IF;

snippet elseif
  ELSIF ${1} THEN
    ${0:TARGET}


snippet case
  CASE ${1}
    ${0:TARGET}
  END CASE;

snippet when
  WHEN ${1} THEN
    ${0:TARGET}

snippet for
  FOR ${1} IN ${2} LOOP
    ${0:TARGET}
  END LOOP;

snippet loop
  LOOP
    ${0:TARGET}
  END LOOP;

snippet while
  WHILE ${1} LOOP
    ${0:TARGET}
  END LOOP;

snippet continue
  CONTINUE WHEN ${1};

snippet procedure
  CREATE OR REPLACE PROCEDURE ${1}(${2})
  IS
    ${3}
  BEGIN
    ${0:TARGET}
  END;
  /

snippet function
  CREATE OR REPLACE FUNCTION ${1}(${2})
  RETURN ${3}
  IS
    ${4}
  BEGIN
    ${0:TARGET}
  END;
  /
